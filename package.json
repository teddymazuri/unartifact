{
  "name": "unartifact",
  "version": "1.0.0",
  "private": true,
  "description": "UnArtifact — Client-Side AI Document Sanitizer & Artifact Remover. 100% offline-first.",
  "scripts": {
    "dev": "npx serve . -l 5173",
    "build:css": "tailwindcss -i ./assets/css/styles.css -o ./assets/css/build.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/styles.css -o ./assets/css/build.css --watch",
    "build": "npm run build:css",
    "preview": "npx serve . -l 4173"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "serve": "^14.2.4"
  }
}